# Ribosome .gitignore
#
# The block-secrets pre-commit hook is the primary defence against
# committing secrets. This file is a second layer: it keeps obvious noise
# and obvious secrets out of `git status` so they are less likely to be
# staged by mistake.

# OS noise
.DS_Store
Thumbs.db

# Editor noise
*.swp
*.swo
.idea/
.vscode/
*.sublime-*

# Node / Bun / Python noise (in case the stack lands on any of these)
node_modules/
.next/
dist/
build/
.turbo/
__pycache__/
*.pyc
.venv/
venv/

# Logs and local dumps
*.log
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*

# Secrets (the hook also blocks these; this stops them appearing in status)
.env
.env.local
.env.*.local
!.env.example
!.env.sample
!.env.template
!.env.dist
*.key
*.pem
secrets.*

# Memory volatile state (per PLAN.md §13 Q8, distilled stays out of git
# by default; MEMORY.md is the human-readable digest that gets checked in
# when Phase 4.5 ships).
.claude/memory/live/*
!.claude/memory/live/.gitkeep
.claude/memory/distilled/*
!.claude/memory/distilled/.gitkeep
.claude/memory/distilled.archive/*
!.claude/memory/distilled.archive/.gitkeep
