{
  "$schema": "https://code.claude.com/schemas/settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/enforce-scope.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/enforce-distilled-write.sh"
          }
        ]
      }
    ]
  }
}
