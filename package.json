{
  "name": "ribosome",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Workflow that ships a GitHub Issue to a merged PR. See OPERATOR.md for the non-coder surface and CLAUDE.md for the architecture.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --passWithNoTests --exclude '**/matrix.test.ts' --exclude 'tests/acceptance/**'",
    "test:watch": "vitest --passWithNoTests --exclude '**/matrix.test.ts' --exclude 'tests/acceptance/**'",
    "test:acceptance": "vitest run --passWithNoTests tests/acceptance",
    "verify": "vitest run src/verify/matrix.test.ts",
    "memory:snapshot": "bash scripts/memory-snapshot.sh",
    "chain:show": "node --experimental-strip-types scripts/chain-show.ts",
    "chain:list": "node --experimental-strip-types scripts/chain-show.ts list",
    "chain:board": "node --experimental-strip-types scripts/mission-control.ts",
    "capture:evidence": "node --experimental-strip-types scripts/capture-evidence.ts",
    "dream:show": "node --experimental-strip-types scripts/dream-show.ts",
    "dream:forget": "node --experimental-strip-types scripts/dream-forget.ts",
    "dream:decay": "node --experimental-strip-types scripts/dream-decay.ts",
    "setup": "node --experimental-strip-types scripts/setup-bootstrap.ts",
    "setup:check": "node --experimental-strip-types scripts/setup-check.ts",
    "eval": "node --experimental-strip-types scripts/eval.ts",
    "state:build": "node --experimental-strip-types scripts/state-build.ts"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^25.9.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^15.11.7",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^2.1.8"
  }
}
